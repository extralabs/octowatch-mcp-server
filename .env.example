# OctoWatch MCP — copy to .env and adjust.
# WARNING: Do NOT put production passwords in config files or commit them.
# Prefer a dedicated read-only / limited console operator for real tenants.
#
# Product: https://octowatchdlp.com/
# Product docs: https://octowatchdlp.com/docs/
# Web Console: https://app.octowatchdlp.com/
# In-app API catalog: https://app.octowatchdlp.com/api/

# API host (spm-config serverBase — not the marketing SPA).
OCTOWATCH_API_BASE=https://cloud.octowatchdlp.com

# Defaults below are the public demo account — fine for local try-out only.
# For your tenant, replace with your console operator email/password
# (or set the same keys in the MCP host JSON "env" block — see docs/hosts.md).
OCTOWATCH_EMAIL=demo@octowatchdlp.com
OCTOWATCH_PASSWORD=demo

# Optional: default lookback (days) when a tool omits date_from / period
# OCTOWATCH_DEFAULT_DAYS=1

# Optional: which tools to register — all | core | console | core,console
# (console alone still includes core)
# OCTOWATCH_TOOLSETS=all
